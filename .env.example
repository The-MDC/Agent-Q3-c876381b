# ═══════════════════════════════════════════════════════════════════
# Agent-Q3 — Environment Variables
# ALL inference via Ollama Cloud (no local GGUFs, no GPU required)
# Account: nicholasjmcleod@gmail.com / Device: LN-8RDGA90Ultra
# Production: HuggingFace Spaces (madDegen/agent-q3-space)
# ═══════════════════════════════════════════════════════════════════

# ── Ollama Cloud auth — mount ~/.ollama for device key ────────────
OLLAMA_CLOUD_ENABLED=true
OLLAMA_CLOUD_ACCOUNT=nicholasjmcleod@gmail.com
OLLAMA_CLOUD_DEVICE=LN-8RDGA90Ultra

# ── Cloud model assignments ───────────────────────────────────────
# [1] Reasoner — Kimi-K2.6 BF16 via HF Router (/v1/instruct, /v1/chat)
REASONER_MODEL=moonshotai/Kimi-K2.6

# [2] Tandem — Hermes3 8B  (/v1/tandem stage-2, /v1/coder/review stage-2)
TANDEM_MODEL=hermes3:8b-cloud

# [3] Coder — Qwen3-48B-A4B  (/v1/code, /v1/tandem stage-3)
CODER_MODEL=qwen3:48b-a4b-cloud

# [4] Fallback — Qwopus3.6-27B  (/v1/fallback)
FALLBACK_MODEL=qwopus:27b-cloud

# [5] Dedicated coder — Qwen3-Coder-30B-A3B  (/v1/coder, /v1/coder/review)
CODER_DEDICATED_MODEL=qwen3-coder:30b-a3b-cloud

# ── Compute strategy ──────────────────────────────────────────────
# cloud_priority = Ollama Cloud → OpenRouter → HuggingFace → RunPod
COMPUTE_STRATEGY=cloud_priority
REQUEST_TIMEOUT_SECS=300

# ── OpenRouter (secondary compute) ───────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── HuggingFace (primary reasoner + tertiary compute) ────────────
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TOKEN_2=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TOKEN_3=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── RunPod Serverless (quaternary — GPU burst) ────────────────────
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RUNPOD_REASONER_ENDPOINT_ID=kukl55t0053lob
RUNPOD_CODER_ENDPOINT_ID=kukl55t0053lob

# ── Research / Search APIs ────────────────────────────────────────
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMITHERY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Shared infrastructure ─────────────────────────────────────────
REDIS_URL=redis://default:PASSWORD@redis.internal:6379

# ── Open WebUI + Pipelines (multi-agent GUI) ─────────────────────
WEBUI_SECRET_KEY=change-me-to-a-random-secret
# Shared key between Open WebUI and the Pipelines container.
# Open WebUI sends this as the OpenAI API key when calling Pipelines.
PIPELINES_API_KEY=0p3n-w3bu!
WEBUI_NAME=MAD Gambit AI

# ── HuggingFace Spaces deploy ─────────────────────────────────────
# Set in GitHub Actions secrets — used by 5-hf-spaces-deploy.yml
# HF_TOKEN (above) is also the deploy token

# ── Server ────────────────────────────────────────────────────────
PORT=7860
LOG_LEVEL=info
